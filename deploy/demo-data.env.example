# Copy outside the checkout, populate with random values, chmod 600, and never commit it.
COMPOSE_PROJECT_NAME=trace-demo-data
TRACE_POSTGRES_DB=trace
TRACE_POSTGRES_USER=trace
TRACE_POSTGRES_PASSWORD=replace-with-a-long-random-value
TRACE_MINIO_ROOT_USER=replace-with-a-random-access-key
TRACE_MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
TRACE_MINIO_HOST_PORT=59000
TRACE_GENESIS_FILE=/etc/trace-demo/genesis.json
