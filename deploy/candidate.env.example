# Non-secret candidate orchestration values. Keep populated files on the host.
COMPOSE_PROJECT_NAME=trace-demo-blue
TRACE_RELEASE_SHA=0000000000000000000000000000000000000000
TRACE_RELEASE_RECEIPT=/opt/trace-public-demo/releases/0000000000000000000000000000000000000000/images.env
TRACE_RUNTIME_NETWORK=trace-demo-data_default
TRACE_API_ENV_FILE=/var/lib/trace-demo/secrets/api.env
TRACE_WEB_ENV_FILE=/var/lib/trace-demo/secrets/web.env
TRACE_API_IMAGE=trace-demo-api:0000000000000000000000000000000000000000
TRACE_API_IMAGE_ID=sha256:replace-me
TRACE_WEB_IMAGE=trace-demo-web:0000000000000000000000000000000000000000
TRACE_WEB_IMAGE_ID=sha256:replace-me
TRACE_OPS_IMAGE=trace-demo-ops:0000000000000000000000000000000000000000
TRACE_OPS_IMAGE_ID=sha256:replace-me
TRACE_API_HOST_PORT=5004
TRACE_WEB_HOST_PORT=5003
