{
  "name": "trace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "env:init": "node scripts/init-local-env.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "e2e": "pnpm --filter @trace/e2e e2e",
    "e2e:ui": "pnpm --filter @trace/e2e e2e:ui",
    "e2e:smoke": "pnpm --filter @trace/e2e e2e:smoke",
    "e2e:visual": "pnpm --filter @trace/e2e e2e:visual",
    "e2e:update": "pnpm --filter @trace/e2e e2e:update",
    "e2e:explore": "pnpm --filter @trace/e2e explore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "public:check": "node scripts/check-public-boundary.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @trace/db migrate",
    "db:seed": "pnpm --filter @trace/db seed",
    "demo:replenish": "pnpm --filter @trace/db demo:replenish",
    "demo:trim-active": "pnpm --filter @trace/db demo:trim-active",
    "db:generate": "pnpm --filter @trace/db generate",
    "db:studio": "pnpm --filter @trace/db studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "keccak",
      "msgpackr-extract",
      "secp256k1"
    ],
    "overrides": {
      "@nomicfoundation/hardhat-ethers": "3.1.3",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "lodash": "4.18.0",
      "next>postcss": "8.5.18",
      "ws@8.17.1": "8.21.0",
      "ws@8.18.3": "8.21.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
