# Temporary HTTP-only vhost for initial ACME issuance. Install through etcedit,
# validate, reload nginx, issue the certificate with Certbot webroot mode, then
# replace this file with demo.conf.example before enabling public traffic.
server {
    listen 80;
    listen [::]:80;
    server_name demo.trace.adventurous.systems;

    root /var/lib/trace-demo/config/nginx/acme-webroot;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        return 503;
    }
}
