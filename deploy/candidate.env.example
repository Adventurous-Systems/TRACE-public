# Non-secret candidate deployment configuration. Keep the real file on the host.
COMPOSE_PROJECT_NAME=trace-staging-candidate
TRACE_RUNTIME_NETWORK=trace-staging_default
TRACE_ENV_FILE=/etc/trace/staging.env
TRACE_API_IMAGE=ghcr.io/example/trace-api@sha256:replace-me
TRACE_WEB_IMAGE=ghcr.io/example/trace-web@sha256:replace-me
TRACE_API_HOST_PORT=4104
TRACE_WEB_HOST_PORT=4103
