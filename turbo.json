{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "API_PORT",
        "API_URL",
        "DATABASE_URL",
        "DEMO_APPLICANT_PASSWORD",
        "DEMO_BUYER_PASSWORD",
        "DEMO_HUB_ADMIN_PASSWORD",
        "DEMO_HUB_STAFF_PASSWORD",
        "DEMO_INSPECTOR_PASSWORD",
        "DEMO_PLATFORM_ADMIN_PASSWORD",
        "DEMO_SIMULATE_ANCHOR",
        "DEMO_SUPPLIER2_PASSWORD",
        "DEMO_SUPPLIER_PASSWORD",
        "DEPLOYER_PRIVATE_KEY",
        "JWT_EXPIRY",
        "JWT_SECRET",
        "MINIO_ENDPOINT",
        "MINIO_PORT",
        "MINIO_PUBLIC_URL",
        "NODE_ENV",
        "REDIS_URL",
        "TRACE_DEPLOYMENT_PROFILE",
        "WEB_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
