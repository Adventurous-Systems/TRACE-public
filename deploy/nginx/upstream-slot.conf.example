# Include this file once inside the TRACE nginx `server` block, before its
# locations. Keep one file per A/B slot and make the active include a symlink.
# Variables allow the same /api/, /minio/, and / locations to remain unchanged.
set $trace_api_origin http://127.0.0.1:4104;
set $trace_web_origin http://127.0.0.1:4103;

# The MinIO origin remains owned by the existing stateful Compose project.
set $trace_minio_origin http://127.0.0.1:29000;
