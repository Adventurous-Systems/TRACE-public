[Unit]
Description=TRACE public-demo catalogue replenishment
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/var/lib/trace-demo/config/active.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=TRACE_DEPLOY_CONFIG_DIR=/var/lib/trace-demo/config
ExecStart=/usr/local/libexec/trace-demo/run-replenish.sh /var/lib/trace-demo/config/active.env
