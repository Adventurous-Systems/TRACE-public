FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter='@trace/db...' build
RUN pnpm --filter=@trace/db deploy --prod /out/ops

FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runner

RUN apk upgrade --no-cache && apk add --no-cache libc6-compat \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v* \
  /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
  /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /out/ops ./

# Object storage (R4): a deployment mounts its store here; a named volume
# starts with this owner, so the node user can write to it.
RUN mkdir -p /var/lib/trace/objects && chown node:node /var/lib/trace/objects
USER node
ENTRYPOINT ["node"]
CMD ["dist/scripts/migrate.js"]
