{
  "name": "trace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "env:init": "node scripts/init-local-env.mjs",
    "stack": "bash scripts/local-stack.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "e2e": "pnpm --filter @trace/e2e e2e",
    "e2e:ui": "pnpm --filter @trace/e2e e2e:ui",
    "e2e:smoke": "pnpm --filter @trace/e2e e2e:smoke",
    "e2e:visual": "pnpm --filter @trace/e2e e2e:visual",
    "e2e:update": "pnpm --filter @trace/e2e e2e:update",
    "e2e:explore": "pnpm --filter @trace/e2e explore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "public:check": "node scripts/check-public-boundary.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @trace/db migrate",
    "db:seed": "pnpm --filter @trace/db seed",
    "demo:replenish": "pnpm --filter @trace/db demo:replenish",
    "demo:trim-active": "pnpm --filter @trace/db demo:trim-active",
    "db:generate": "pnpm --filter @trace/db generate",
    "db:studio": "pnpm --filter @trace/db studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "keccak",
      "msgpackr-extract",
      "secp256k1"
    ],
    "overrides": {
      "@nomicfoundation/hardhat-ethers": "3.1.3",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.8",
      "lodash": "4.18.0",
      "next>postcss": "8.5.23",
      "ws@8.17.1": "8.21.0",
      "ws@8.18.3": "8.21.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "brace-expansion@<1.1.16": "^1.1.16",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=3.0.0 <5.0.7": "^5.0.7",
      "flatted@<3.4.2": "^3.4.2",
      "follow-redirects@<1.16.0": "^1.16.0",
      "immutable@>=4.0.0-rc.1 <4.3.9": "^4.3.9",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "uuid@>=11.0.0 <11.1.1": "^11.1.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "cookie@<0.7.0": "^0.7.0",
      "tmp@<0.2.6": "^0.2.6",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "decode-uri-component@<0.5.0": "^0.5.0",
      "uuid@<11.1.1": "^11.1.1",
      "undici@<6.28.0": "^6.28.0",
      "adm-zip@<0.6.1": "^0.6.1",
      "esbuild@<0.25.0": "^0.25.12",
      "@fastify/busboy@<3.2.1": "^3.2.1",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
