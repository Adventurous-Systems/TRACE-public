# Install this file in nginx's `http` context after reviewing certificate paths.
# The active upstream include is mutable deployment state outside /etc.
limit_req_zone $binary_remote_addr zone=trace_demo_read:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=trace_demo_conn:10m;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name demo.trace.adventurous.systems;

    ssl_certificate /etc/letsencrypt/live/demo.trace.adventurous.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.trace.adventurous.systems/privkey.pem;

    include /var/lib/trace-demo/config/nginx/active.conf;

    client_max_body_size 20m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 30s;

    limit_conn trace_demo_conn 20;
    limit_req zone=trace_demo_read burst=40 nodelay;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    if (-f /var/lib/trace-demo/state/maintenance.enabled) {
        return 503;
    }

    error_page 503 /maintenance.html;
    location = /maintenance.html {
        root /etc/trace-demo/nginx;
        internal;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_pass $trace_api_origin;
    }

    location /health/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_pass $trace_api_origin;
    }

    location /minio/ {
        limit_except GET HEAD OPTIONS { deny all; }
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        rewrite ^/minio/(.*)$ /$1 break;
        proxy_pass $trace_minio_origin;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_pass $trace_web_origin;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name demo.trace.adventurous.systems;
    return 301 https://$host$request_uri;
}
